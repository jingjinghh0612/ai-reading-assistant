# Copy this file to .env and fill in your real key.
# Do not commit .env to git.

# AI_PROVIDER can be "deepseek" or "gemini".
AI_PROVIDER=deepseek

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional. Tune Gemini request stability.
GEMINI_TIMEOUT_MS=25000
GEMINI_RETRY_COUNT=2
GEMINI_RETRY_DELAY_MS=1200
AI_CACHE_TTL_MS=86400000

# Optional. Prototype word lookup uses an external dictionary before AI fallback.
EXTERNAL_DICTIONARY_ENABLED=true
EXTERNAL_DICTIONARY_TIMEOUT_MS=5000
MYMEMORY_EMAIL=

# Optional. Use this only if your network needs a local proxy to reach Gemini.
GEMINI_PROXY_URL=http://127.0.0.1:7890
