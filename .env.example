# Copy this file to .env and fill in your real key.
# Do not commit .env to git.

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional. Total DeepSeek fetch and response-body timeout in milliseconds.
DEEPSEEK_TIMEOUT_MS=25000

# Optional. Translation cache lifetime in milliseconds.
AI_CACHE_TTL_MS=86400000

# Optional. Prototype word lookup uses an external dictionary before AI fallback.
EXTERNAL_DICTIONARY_ENABLED=true
EXTERNAL_DICTIONARY_TIMEOUT_MS=5000
MYMEMORY_EMAIL=

# Optional. Set this if your network needs a proxy for backend requests.
# HTTPS_PROXY=http://127.0.0.1:7890
